<?xml version="1.0" encoding="utf-8"?>
<!--
    fitsSystemWindows is required, not decoration: targeting SDK 35 opts the app into Android 15's
    edge-to-edge enforcement, so without it the window extends behind the status bar and action
    bar and the first heading is drawn underneath them. clipToPadding keeps that inset padding
    from cutting content off mid-scroll.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <com.aidley.uvwidget.UvGraphView
            android:id="@+id/uv_graph"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginBottom="20dp"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/config_title"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/background_location_note"
            android:textSize="13sp" />

        <Button
            android:id="@+id/refresh_location"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/refresh_location" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/status_no_location_short"
            android:textStyle="italic" />

        <CheckBox
            android:id="@+id/set_location_manually"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/set_location_manually" />

        <!-- Shown only while the checkbox above is ticked. -->
        <LinearLayout
            android:id="@+id/manual_location_fields"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <EditText
                android:id="@+id/latitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/latitude_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />

            <EditText
                android:id="@+id/longitude"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/longitude_hint"
                android:importantForAutofill="no"
                android:inputType="numberSigned|numberDecimal" />

        </LinearLayout>

        <Button
            android:id="@+id/save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/save" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center_horizontal"
            android:textSize="12sp" />

    </LinearLayout>

</ScrollView>
